DATABASE_URL=sqlite+aiosqlite:///./digital_workforce.db
# local：显式无认证开发模式；token：JWT 用户认证与租户隔离模式。
AUTH_PROFILE=local
# AUTH_PROFILE=token 时必填，至少 32 字节；请使用随机值，勿提交真实密钥。
JWT_SECRET=
ACCESS_TOKEN_TTL_S=900
REFRESH_TOKEN_TTL_S=604800
UNIVERSAL_CONTRACT_LLM_BASE_URL=https://api.openai.com/v1
UNIVERSAL_CONTRACT_LLM_API_KEY=
UNIVERSAL_CONTRACT_LLM_MODEL=gpt-4o-mini